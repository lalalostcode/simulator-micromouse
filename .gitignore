# Build artifacts from compiling algorithms (not the vendored mms.exe)
sim/algorithms/**/*.exe
sim/algorithms/**/*.o
sim/algorithms/**/*.obj

# Python bytecode cache. Hasil run q-learning (qtable_state.pkl, qtable_export.*,
# episode_log.csv, training_plot.png, qpath_frames/) SENGAJA di-track.
sim/algorithms/**/__pycache__/
sim/webots/**/__pycache__/

# Webots menulis file state GUI (posisi viewpoint, dll) per-user saat world dibuka.
sim/webots/**/*.wbproj

# Log hasil run controller (run_log.txt), dibuat ulang tiap kali disimulasikan.
sim/webots/**/run_log.txt

# Keluaran training Q-learning di Webots (dibuat ulang tiap run).
sim/webots/**/qlearning/episode_log.csv
sim/webots/**/qlearning/qtable_state.pkl

# Webots continuous_qlearning: hanya hasil *_best (data) + hasil_analisis/*_best.png, *_best.gif
# dan ringkasan_best.txt yang di-push. Keluaran training biasa (dibuat ulang tiap run) dan
# grafik/GIF tanpa _best boleh ada lokal tetapi tidak ikut git.
sim/webots/**/continuous_qlearning/qtable_state.pkl
sim/webots/**/continuous_qlearning/episode_log.csv
sim/webots/**/continuous_qlearning/eval_result.json
sim/webots/**/continuous_qlearning/hasil_analisis/*.png
!sim/webots/**/continuous_qlearning/hasil_analisis/*_best.png
sim/webots/**/continuous_qlearning/hasil_analisis/*.gif
!sim/webots/**/continuous_qlearning/hasil_analisis/*_best.gif
sim/webots/**/continuous_qlearning/hasil_analisis/ringkasan.txt

# Webots continuous_dqn: sama dengan continuous_qlearning, hanya hasil *_best (data) + hasil_analisis/*_best.png,
# *_best.gif dan ringkasan_best.txt yang di-push. Keluaran training biasa tidak ikut git.
sim/webots/**/continuous_dqn/dqn_model.pt
sim/webots/**/continuous_dqn/dqn_model_last.pt
sim/webots/**/continuous_dqn/episode_log.csv
sim/webots/**/continuous_dqn/eval_result.json
sim/webots/**/continuous_dqn/eval_result_rate_tertinggi.json
sim/webots/**/continuous_dqn/stuck_hotspots.json
sim/webots/**/continuous_dqn/hasil_analisis/*.png
!sim/webots/**/continuous_dqn/hasil_analisis/*_best.png
sim/webots/**/continuous_dqn/hasil_analisis/*.gif
!sim/webots/**/continuous_dqn/hasil_analisis/*_best.gif
sim/webots/**/continuous_dqn/hasil_analisis/ringkasan.txt
